# Copy to .env and fill in. .env is never committed
PORT=5600
NODE_ENV=development

# Neon: the dev branch for running the app, the test branch for npm test
DB_URL=
TEST_DB_URL=

# Arcjet. Development mode follows NODE_ENV=development
ARCJET_KEY=

# Cloudinary, first used in phase 1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The admin account npm run db:seed creates
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# The one-off MySQL import (npm run db:import). Leave empty for XAMPP's default, root with no password
MYSQL_URL=
