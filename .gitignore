# .gitignore for WorldQuiz
#
# Strategy: explicit, grouped, commented. Easier to audit than a giant flat list.

# ─── Personal / per-machine ────────────────────────────────────────────
CLAUDE.local.md
.claude/settings.local.json
.claude/local/
.claude/cache/

# ─── Generated / regenerable ───────────────────────────────────────────
graphify-out/
memory/
*.bak
*.tmp

# ─── Scratch / one-off ─────────────────────────────────────────────────
palette-preview.html
tasks/

# ─── Secrets & env ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Logs ──────────────────────────────────────────────────────────────
*.log
logs/

# ─── PHP ecosystem (future-proofing if you adopt Composer) ─────────────
vendor/
composer.phar
# composer.lock — intentionally NOT ignored; lock files should be committed

# ─── Node ecosystem (future-proofing if you adopt npm/build tools) ─────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json — intentionally NOT ignored; lock files should be committed

# ─── OS pollution ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ─── Editor / IDE ──────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.history/
