{
  // Runner options for markdownlint-cli2. Rules live in .markdownlint.jsonc.
  //
  // `ignores` only works here. In a rules file it is silently discarded, which
  // is how a lint run ends up walking every README inside node_modules.
  //
  // Patterns are `**/`-prefixed so they match at any depth. A bare
  // `node_modules/**` only matches a root-level folder, and in a monorepo the
  // real ones sit under client/ and server/ — that mistake let 20,334 errors
  // through in a sibling repo before it was caught. Added 2026-08-31.

  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/graphify-out/**",
    "**/vendor/**"
  ]
}
